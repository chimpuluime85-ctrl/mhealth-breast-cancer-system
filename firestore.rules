rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return signedIn() && currentUser().role == 'admin';
    }

    function isActiveDoctor() {
      return signedIn()
        && currentUser().role == 'doctor'
        && currentUser().status == 'active';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasValidBaseProfile() {
      return request.resource.data.keys().hasAll([
        'name',
        'email',
        'phone',
        'role',
        'status',
        'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.email is string
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.phone is string
      && request.resource.data.phone.size() <= 30
      && request.resource.data.createdAt == request.time;
    }

    function validPatientProfile() {
      return hasValidBaseProfile()
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'role',
          'status',
          'createdAt',
          'profileImage'
        ])
        && request.resource.data.role == 'patient'
        && request.resource.data.status == 'active';
    }

    function validDoctorProfile() {
      return hasValidBaseProfile()
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'role',
          'status',
          'createdAt',
          'profileImage',
          'specialization'
        ])
        && request.resource.data.specialization is string
        && request.resource.data.specialization.size() > 0
        && request.resource.data.specialization.size() <= 120
        && request.resource.data.role == 'doctor'
        && request.resource.data.status == 'pending';
    }

    function validSelfProfileUpdate() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'phone',
            'profileImage',
            'specialization'
          ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || isAdmin()
        || (
          isActiveDoctor()
          && resource.data.role == 'patient'
        );

      allow create: if isOwner(userId)
        && (
          validPatientProfile()
          || validDoctorProfile()
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && validSelfProfileUpdate()
        );

      allow delete: if isAdmin();
    }

    match /appointments/{documentId} {
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid;

      allow read: if isAdmin()
        || isActiveDoctor()
        || (
          signedIn()
          && resource.data.patientId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /riskAssessments/{documentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || isActiveDoctor()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /symptoms/{documentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || isActiveDoctor()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /medicalRecords/{documentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || isActiveDoctor()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /reports/{documentId} {
      allow read: if isAdmin()
        || isActiveDoctor()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isActiveDoctor()
          && request.resource.data.userId is string
          && request.resource.data.doctorId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.summary is string
          && request.resource.data.createdAt == request.time
        );

      allow update, delete: if isAdmin()
        || (
          isActiveDoctor()
          && resource.data.doctorId == request.auth.uid
        );
    }

    match /education/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /notifications/{documentId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update, delete: if isAdmin();
    }

    match /messages/{documentId} {
      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if signedIn()
        && (
          request.resource.data.senderId == request.auth.uid
          || request.resource.data.receiverId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }
  }
}